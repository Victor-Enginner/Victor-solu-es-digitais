# ============ Supabase (obrigatório para o modo real) ============
# Supabase > botão "Connect" ou Project Settings > API.
# A publishable/anon key PODE ficar no navegador. NUNCA coloque aqui a secret/service_role key
# nem a senha do banco.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# URL pública do site (usada nos links das mensagens)
NEXT_PUBLIC_SITE_URL=https://victor-solu-es-digitais.vercel.app

# ============ Notificações (SOMENTE servidor, sem NEXT_PUBLIC_) ============
# E-mail via Resend (https://resend.com). Crie a conta Resend com o mesmo e-mail de destino,
# porque sem domínio verificado o Resend só entrega para o e-mail dono da conta.
RESEND_API_KEY=
# RESEND_FROM=Victor AI <onboarding@resend.dev>
NOTIFY_EMAIL=securitysuporte@proton.me

# WhatsApp automático via gateway (Evolution API / Z-API). Opcional.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
ADMIN_WHATSAPP=5516982141822
